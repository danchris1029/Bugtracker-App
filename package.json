{
  "name": "bugtracker2.0",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "full-install": "concurrently \"npm install\" \"cd ./client && npm install\"",
    "client": "cd ./client && npm start",
    "start": "node server.js",
    "dev": "concurrently -n 'server,client' -c 'red,green' \"npx nodemon server.js\" \"npm run client\""
  },
  "keywords": [],
