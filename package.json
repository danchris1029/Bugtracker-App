  "license": "ISC",
  "dependencies": {
    "concurrently": "^6.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "express-openid-connect": "^2.8.0",
    "http-proxy-middleware": "^2.0.1",
    "mongoose": "^5.13.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "sass": "^1.37.0"
  }
}
